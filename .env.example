# Copy this file to .env at the project root and fill in real values
# before running `docker compose up` (see docker-compose.yml). Never
# commit the real .env file.

# --- Postgres (used by docker-compose.yml) ---
POSTGRES_USER=microlink
POSTGRES_PASSWORD=microlink
POSTGRES_DB=postgres

# --- Shared secrets ---
JWT_SECRET=change-me-to-a-long-random-string

# Get one from https://console.cloud.google.com/google/maps-apis (Google Maps
# Platform) or https://account.mapbox.com (Mapbox). Used by navigation-service.
MAPS_API_KEY=

# --- Per-service DATABASE_URL (only needed if you run a service outside
#     docker compose, e.g. locally against the compose Postgres on :5432) ---
# --- User Management Service ---
# DATABASE_URL=postgresql://microlink:microlink@localhost:5432/user_db

# --- Smart Shop Discovery Service ---
# DATABASE_URL=postgresql://microlink:microlink@localhost:5432/shop_db

# --- AI Recommendation Service ---
# DATABASE_URL=postgresql://microlink:microlink@localhost:5432/recommendation_db

# --- Navigation & Route Optimization Service ---
# DATABASE_URL=postgresql://microlink:microlink@localhost:5432/navigation_db

# --- Self Driver / Delivery Service ---
# DATABASE_URL=postgresql://microlink:microlink@localhost:5432/delivery_db

# --- Crowd-Sourced Data Service ---
# DATABASE_URL=postgresql://microlink:microlink@localhost:5432/crowdsource_db

# --- Admin & Monitoring Service ---
# DATABASE_URL=postgresql://microlink:microlink@localhost:5432/admin_db

# NOTE: infra/docker-compose.local-db.yml is a separate, simpler
# Postgres-only setup some teammates use for local DB testing; it has its
# own credentials and DB names (see DATABASE_SETUP.md) and does not read
# this file.
