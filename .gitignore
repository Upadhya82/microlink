.DS_Store
Thumbs.db
.vscode/
.idea/
*.iml

# Never commit real secrets/environment values - only .env.example files.
.env
*.env
!.env.example

# Python
__pycache__/
*.pyc

# Flutter / Dart build output - regenerated by `flutter pub get` and
# `flutter build`, and around 86MB, so it has no business in the history.
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
*.g.dart.js
